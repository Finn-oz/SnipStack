{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    },
    "windows": [
      {
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "decorations": false,
        "focusable": false,
        "height": 600,
        "label": "clipboard",
        "maximizable": false,
        "minHeight": 600,
        "minWidth": 360,
        "skipTaskbar": true,
        "title": "SnipStack",
        "transparent": true,
        "url": "index.html/#/",
        "visible": false,
        "width": 360
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright 2026 SnipStack Contributors. Based on EcoPaste, Copyright ayangweb.",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "description": "SnipStack history backup",
        "exportedType": {
          "conformsTo": ["public.data"],
          "identifier": "com.snipstack.app.backup"
        },
        "ext": ["snipstackbak"],
        "mimeType": "application/vnd.snipstack.backup",
        "name": "SnipStack Backup",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": ["assets/tray.ico", "resources/ocr/"],
    "shortDescription": "SnipStack",
    "targets": ["nsis", "dmg", "app"]
  },
  "identifier": "com.snipstack.app",
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/snipstack/SnipStack/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMzUzRkJCQUI3NjY4RgpSV1NQWnJlNisxTURBbFE2WWJpUlBJR0x0OXJOclVuUGlVYVhoNjJPZitYN0Q4V05GeW1aU2w0Zwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "productName": "SnipStack",
  "version": "../package.json"
}
